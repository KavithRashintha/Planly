# Planly Environment Configuration Template

# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AUTH_DB_NAME=auth_db
PLANNER_DB_NAME=planner_db
NOTIFY_DB_NAME=notify_db
AGENT_DB_NAME=agent_db

# Security & Tokens
JWT_SECRET=planly-development-secret-key-at-least-32-bytes-long!
INTERNAL_API_KEY=planly-development-internal-key-change-me

# Service Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PLANNER_SERVICE_PORT=8082
NOTIFY_SERVICE_PORT=8083
AGENT_SERVICE_PORT=8084

# Service URLs (for gateway and internal calls)
AUTH_SERVICE_URL=http://localhost:8081
PLANNER_SERVICE_URL=http://localhost:8082
NOTIFY_SERVICE_URL=http://localhost:8083
AGENT_SERVICE_URL=http://localhost:8084

# LLM Provider (Anthropic takes priority; Gemini is the free/open fallback)
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
# Optional: set ANTHROPIC_API_KEY to use Claude instead
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Frontend
VITE_API_URL=http://localhost:8080/api/v1
